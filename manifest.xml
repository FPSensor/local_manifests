<?xml version="1.0" encoding="UTF-8"?>
<!--
  FPSensor local manifest: Moto X4 (payton) on LineageOS 22.2 with kernel 4.19.

  Usage:
    repo init -u https://github.com/LineageOS/android.git -b lineage-22.2 (add git-lfs)
    git clone -b lineage-22.2 https://github.com/FPSensor/local_manifests .repo/local_manifests
    repo sync

  Every project is hosted at github.com/FPSensor; the comment above each
  one names the upstream it was imported from (history preserved).

  HALs: LineageOS 22.2 maps sdm660 with TARGET_ENFORCES_QSSI to
  UM_4_19_LEGACY_FAMILY (hardware/qcom-caf/common), and its
  lineage-22.2-caf-sdm660 audio/display/media are the 4.19 HALs, so the
  stock LineageOS projects are used (no overrides needed, unlike 20.0).
-->
<manifest>
  <remote name="fpsensor" fetch="https://github.com/FPSensor" />

  <!--
    Latest AOSP clang (r614150, clang 23.0.1) for the kernel
    (TARGET_KERNEL_CLANG_VERSION := r614150). It is only published on the
    llvm toolchain mirror branch, and its binaries exceed GitHub's 100MB
    file limit, so it is fetched from AOSP directly and linked into the
    path vendor/lineage expects.
  -->
  <project path="prebuilts/clang/host/linux-x86-llvm-toolchain" name="platform/prebuilts/clang/host/linux-x86" remote="aosp" revision="refs/heads/mirror-goog-main-llvm-toolchain-source" clone-depth="1" groups="pdk">
    <linkfile src="clang-r614150" dest="prebuilts/clang/host/linux-x86/clang-r614150" />
  </project>

  <!-- Device -->
  <!-- imported from LineageOS/android_device_motorola_payton @ lineage-22.2 -->
  <project path="device/motorola/payton" name="android_device_motorola_payton" remote="fpsensor" revision="lineage-22.2" />
  <!-- imported from LineageOS/android_device_motorola_msm8998-common @ lineage-22.2 -->
  <project path="device/motorola/msm8998-common" name="android_device_motorola_msm8998-common" remote="fpsensor" revision="lineage-22.2" />

  <!-- Kernel (same tree as 20.0: 4.19.325, meets the Android 15 4.19 base config) -->
  <!-- imported from moto-common/android_kernel_motorola_msm-4.19 @ 13-beckham-sdm660-7 -->
  <project path="kernel/motorola/sdm660-4.19" name="android_kernel_motorola_sdm660-4.19" remote="fpsensor" revision="lineage-22.2" />
  <!-- Reference only (4.4 sources for porting); not used by the build. -->
  <!-- imported from LineageOS/android_kernel_motorola_msm8998 @ lineage-18.1 -->
  <project path="kernel/motorola/msm8998-4.4" name="android_kernel_motorola_msm8998" remote="fpsensor" revision="lineage-18.1" groups="notdefault,reference" clone-depth="1" />

  <!-- Vendor blobs -->
  <!-- imported from TheMuppets/proprietary_vendor_motorola_payton @ lineage-22.2 -->
  <project path="vendor/motorola/payton" name="proprietary_vendor_motorola_payton" remote="fpsensor" revision="lineage-22.2" />
  <!-- imported from TheMuppets/proprietary_vendor_motorola_msm8998-common @ lineage-22.2 -->
  <project path="vendor/motorola/msm8998-common" name="proprietary_vendor_motorola_msm8998-common" remote="fpsensor" revision="lineage-22.2" />

  <!-- msm8998-common dependencies (lineage.dependencies) -->
  <!-- imported from LineageOS/android_hardware_motorola @ lineage-22.2 -->
  <project path="hardware/motorola" name="android_hardware_motorola" remote="fpsensor" revision="lineage-22.2" />
  <!-- imported from LineageOS/android_external_bson @ lineage-22.2 -->
  <project path="external/bson" name="android_external_bson" remote="fpsensor" revision="lineage-22.2" />
</manifest>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  moto-sdm660 local manifest: Moto X4 (payton) on crDroid 17.0 with kernel 4.19.
  See README.md for how to use it.

  Modified projects are hosted at github.com/moto-sdm660 (the comment above
  each one names its upstream); unmodified dependencies come from LineageOS.
-->
<manifest>
  <remote name="moto-sdm660" fetch="https://github.com/moto-sdm660" />

  <!--
    Latest AOSP clang (r614150, clang 23.0.1) for the kernel
    (TARGET_KERNEL_CLANG_VERSION := r614150). It is only published on the
    llvm toolchain mirror branch, and its binaries exceed GitHub's 100MB
    file limit, so it is fetched from AOSP directly and linked into the
    path vendor/lineage expects.
  -->
  <project path="prebuilts/clang/host/linux-x86-llvm-toolchain" name="platform/prebuilts/clang/host/linux-x86" remote="aosp" revision="refs/heads/mirror-goog-main-llvm-toolchain-source" clone-depth="1" groups="pdk">
    <linkfile src="clang-r614150" dest="prebuilts/clang/host/linux-x86/clang-r614150" />
    <!-- Hide this checkout from Soong/Kati: its Android.bp duplicates the
         modules of prebuilts/clang/host/linux-x86. The finder prunes any
         directory containing .find-ignore (checked with lstat). -->
    <linkfile src="GCC_4_9_DEPRECATION.md" dest="prebuilts/clang/host/linux-x86-llvm-toolchain/.find-ignore" />
  </project>

  <!-- Device -->
  <!-- imported from LineageOS/android_device_motorola_payton -->
  <project path="device/motorola/payton" name="android_device_motorola_payton" remote="moto-sdm660" revision="lineage-24.0" />
  <!-- imported from LineageOS/android_device_motorola_msm8998-common,
       renamed to sdm660-common -->
  <project path="device/motorola/sdm660-common" name="android_device_motorola_sdm660-common" remote="moto-sdm660" revision="lineage-24.0" />

  <!-- Kernel: 4.19.325-cip, based on the official LineageOS sdm660 kernel
       (LineageOS/android_kernel_qcom_sdm660 @ lineage-20) with the payton/Moto
       bring-up on top. Built from vendor/sdm660-perf_defconfig plus
       vendor/ext_config/{moto-sdm660,payton}.config.
       crDroid uses lineage-24.0-perf, which adds the performance work
       (multi-gen LRU, LZ4 1.11, devfreq boost, ...) to lineage-24.0. -->
  <project path="kernel/motorola/sdm660" name="android_kernel_motorola_sdm660" remote="moto-sdm660" revision="lineage-24.0-perf" />

  <!-- Vendor blobs -->
  <!-- imported from TheMuppets/proprietary_vendor_motorola_payton -->
  <project path="vendor/motorola/payton" name="proprietary_vendor_motorola_payton" remote="moto-sdm660" revision="lineage-24.0" />
  <!-- imported from TheMuppets/proprietary_vendor_motorola_msm8998-common,
       renamed to sdm660-common -->
  <project path="vendor/motorola/sdm660-common" name="proprietary_vendor_motorola_sdm660-common" remote="moto-sdm660" revision="lineage-24.0" />

  <!-- sdm660-common dependencies (lineage.dependencies). Unmodified, so
       they come straight from LineageOS; listing them here keeps roomservice
       from adding them. bson is needed by the payton camera blobs and has no
       lineage-24.0 branch, so its latest branch is used. -->
  <project path="hardware/motorola" name="LineageOS/android_hardware_motorola" remote="github" revision="lineage-24.0" />
  <project path="external/bson" name="LineageOS/android_external_bson" remote="github" revision="lineage-22.2" />
</manifest>
